<mujoco model="go2 flat scene + roughness (no strip)">
  <!--
    Variant of scene_flat.xml with the training-cfg roughness hfield
    (height ∈ [0, 0.03] m, 7.5 cm cells; Go2FlatCfg.terrain.height = [0.01, 0.03]).
    No centerline strip. Spawn footprint (x < 0.6 m) is cleared so the robot's
    initial standing pose lands on flat ground; the rest of the corridor is rough.
    Robot spawns at world (0, 0, 0.42); +x is forward.
  -->
  <include file="go2.xml"/>

  <option timestep="0.005"/>

  <statistic center="0 0 0.1" extent="0.8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20" offwidth="1280" offheight="720"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>

    <!-- Roughness across the full corridor (no strip clearing).
         X half = (20.0 − (−0.5))/2 = 10.25, centred at x = 9.75
         Y half = 1.0, centred at y = 0
         Zmax  = 0.03 m,  Zmin  = 0.001 m (1 mm base box; required > 0). -->
    <hfield name="rough_noise" file="rough_noise.png" size="10.25 1.0 0.03 0.001"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" friction="1.0 0.005 0.01"/>

    <geom name="rough_noise" type="hfield" hfield="rough_noise"
          pos="9.75 0 0" material="groundplane"
          friction="1.0 0.005 0.01"/>
  </worldbody>
</mujoco>
