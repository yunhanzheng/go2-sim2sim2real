<mujoco model="go2 single hurdle h10">
  <!--
    Single 0.10 m hurdle at world x=2.1 (matches flyball hurdle1 position), flat
    terrain elsewhere. Derived from scene_flyball35_2h_h10_noffset.xml with the
    second hurdle and the wall removed, for a "drive at 1.5 m/s, jump ONE 10 cm
    hurdle, then zero the velocity command" sim2sim.
    NB: no group attrs on floor/hurdle (default group 0) so they render in the
    live viewer — group="4" geoms are invisible (see project_scene_geom_group4_hidden).
  -->
  <include file="go2.xml"/>
  <option timestep="0.005"/>
  <statistic center="2 0 0.5" extent="3.5"/>
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20" offwidth="1280" offheight="720"/>
  </visual>
  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="obstacle"   rgba="0.55 0.55 0.6 1.0"/>
  </asset>
  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" friction="1.0 0.005 0.01"/>
    <!-- Single hurdle: 0.10 m tall, world x 2.1 (top at z=0.10) -->
    <geom name="flyball_hurdle" type="box"
          pos="2.1 0 0.05" size="0.09 1.0 0.05"
          material="obstacle" friction="1.0 0.005 0.01"/>
  </worldbody>
</mujoco>
