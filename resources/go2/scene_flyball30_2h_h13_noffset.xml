<mujoco model="go2 flyball wall30 2h h13 no-offset">
  <!--
    Same as scene_flyball30_2h_h10_noffset.xml (30 deg wall, runup unchanged)
    but BOTH hurdles raised 0.10 -> 0.13 m tall (z_half 0.05 -> 0.065, recentered
    so the base stays flush on the floor). 0.13 m is inside the cliffside training
    single-hurdle height range [0.05, 0.15].
      wall angle 30 deg -> tilt-from-vertical 60 deg = 1.0472 rad.
        horizontal run = H/tan30 = 1.732 m, slope length = H/sin30 = 2.000 m.
      Wall front-bottom kept at (6.025, 0, 0); top at (7.757, 0, 1.0).
    Hurdles at world x 2.1 and 4.1, now 0.13 m tall.
  -->
  <include file="go2.xml"/>
  <option timestep="0.005"/>
  <statistic center="4 0 0.5" extent="4.5"/>
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20" offwidth="1280" offheight="720"/>
  </visual>
  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="obstacle"   rgba="0.55 0.55 0.6 1.0"/>
    <material name="wall_face"  rgba="0.45 0.45 0.55 1.0"/>
  </asset>
  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" friction="1.0 0.005 0.01"/>
    <!-- Hurdle 1: 0.13 m tall, world x 2.1 -->
    <geom name="flyball_hurdle" type="box"
          pos="2.1 0 0.065" size="0.09 1.0 0.065"
          material="obstacle" friction="1.0 0.005 0.01"/>
    <!-- Hurdle 2: 0.13 m tall, world x 4.1 (2.0 m past hurdle 1) -->
    <geom name="flyball_hurdle2" type="box"
          pos="4.1 0 0.065" size="0.09 1.0 0.065"
          material="obstacle" friction="1.0 0.005 0.01"/>
    <!-- 30 deg wall, no offset, runup-matched: ramp face front-bottom at
         (6.025, 0, 0), top at (7.757, 0, 1.0). -->
    <geom name="flyball_wall_ramp" type="box"
          pos="6.9785 0 0.3484" size="0.1750 1.5 1.0000"
          euler="0 1.0472 0"
          material="wall_face" friction="1.0 0.005 0.01"/>
    <!-- Wall back: x in [7.757, 8.107], z in [0, 1.0] -->
    <geom name="flyball_wall_back" type="box"
          pos="7.9320 0 0.5000" size="0.1750 1.5 0.5000"
          material="obstacle" friction="1.0 0.005 0.01"/>
  </worldbody>
</mujoco>
