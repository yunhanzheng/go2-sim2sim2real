<mujoco model="go2 60deg lean plate + 1 hurdle 20cm high / 25cm thick, spawn-hurdle 1.6m, hurdle-wall gap 1.7m">
  <!-- 5 cm smaller in both dimensions than
       scene_leanplate60_wall3m45_1hurdle_h25_t30_spawn160_gap170.xml.
       Hurdle: center x=1.60 (1.60 m from the spawn at x=0), 0.25 m thick
       (x half-size 0.125, faces at 1.475/1.725), 2.0 m wide, 0.200 m high
       (z half-size 0.10, center z 0.10).
       Wall: the 1.70 m CLEAR gap from the hurdle's far face is preserved, so
       the plate foot moves back 2.5 cm to x=3.425 (plate/room-wall geoms
       shifted -0.025 m). Plate length 1.10 m at 60 deg; surface top x=3.9750,
       z=0.9526; room-wall front face 3.8750. -->
  <include file="go2.xml"/>
  <option timestep="0.005"/>
  <statistic center="2.0 0 0.75" extent="5.0"/>
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20" offwidth="1280" offheight="720"/>
  </visual>
  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
