    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="plate_face" rgba="0.80 0.70 0.45 1.0"/>
    <material name="roomwall" rgba="0.62 0.62 0.66 1.0"/>
    <material name="obstacle" rgba="0.55 0.55 0.6 1.0"/>
