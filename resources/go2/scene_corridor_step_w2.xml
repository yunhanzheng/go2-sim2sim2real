<mujoco model="go2 walled corridor (2.0 m wide, walls only, no step)">
  <!--
    Mid-width variant (walls only): free corridor width = 2.0 m
    (centre of flat_corridor_width_range = [1,3] m). Inner wall faces at
    y = +/-1.0 (centres +/-1.1). Step removed — flat floor + walls only.
    Walls span x in [-1,17] at z top 0.80 m.
  -->
  <include file="go2.xml"/>

  <option timestep="0.005"/>

  <statistic center="6 0 0.3" extent="6"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20" offwidth="1280" offheight="720"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="step"      rgba="0.55 0.55 0.6 1.0"/>
    <material name="wall_face" rgba="0.45 0.45 0.55 1.0"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" friction="1.0 0.005 0.01"/>

    <!-- LATERAL WALLS: inner faces at y=+/-1.0 (2.0 m corridor), centres +/-1.1. -->
    <geom name="corridor_wall_left" type="box"
          pos="8.0 1.1 0.4"
          size="9.0 0.1 0.4"
          material="wall_face"
          friction="1.0 0.005 0.01"/>
    <geom name="corridor_wall_right" type="box"
          pos="8.0 -1.1 0.4"
          size="9.0 0.1 0.4"
          material="wall_face"
          friction="1.0 0.005 0.01"/>
  </worldbody>
</mujoco>
