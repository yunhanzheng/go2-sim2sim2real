<mujoco model="go2 flyball wall70">
  <!--
    Replicates the extreme-parkour `flyball_wall_terrain` (env_class 19) at
    wall angle 70° (= difficulty 0.5 in Go2Advanced2Cfg's [50°, 90°] range).

    Parameter resolution at d = 0.5 (terrain coords; robot spawns at terrain
    x = p_len - 0.5 = 2.0, world x = 0):

      platform_len           = 2.5 m       → spawn platform x ∈ [0, 2.5]
      runup_m                = lerp(5.5, 7.0, 0.5) = 6.25 m
      hurdle (single)        : height 0.125, thickness 0.18, width 2.0,
                               at terrain x = p_len + 1.6 = 4.1
                               (no jitter; jitter range ±0.30 in training)
      wall_thickness         = 0.35 m
      wall_height            = 1.0 m
      wall_width (lateral)   = 3.0 m
      wall_angle_deg         = 70  → 1/tan(70°) = 0.364, 1/sin(70°) = 1.064
      delta_z (wall base)    = lerp(0.05, 0.15, 0.5) = 0.10 m
      wall_front (terrain x) = p_len + runup - thickness = 8.4
                               (= world x 6.4 with spawn-offset 2.0)

    World layout (robot spawns at world (0, 0, 0.30)):
      - flat ground plane
      - hurdle box at (2.1, 0, 0.0625), full size 0.18 × 2.0 × 0.125
      - 10 cm vertical lip at x = 6.4, z ∈ [0, 0.10] (the heightfield step
        between the approach floor and the elevated wall base)
      - inclined ramp box (tilted 20° about +y, top forward): front face
        from (6.4, 0, 0.10) to (6.764, 0, 1.10), thickness 0.35 m, width 3.0 m

    Roughness on the approach floor (training has uniform [-0.04, +0.04] m
    noise) is intentionally omitted — sim2sim runs use a flat approach.
  -->
  <include file="go2.xml"/>

  <option timestep="0.005"/>

  <statistic center="3 0 0.5" extent="3.5"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20" offwidth="1280" offheight="720"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="obstacle"   rgba="0.55 0.55 0.6 1.0"/>
    <material name="wall_face"  rgba="0.45 0.45 0.55 1.0"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" friction="1.0 0.005 0.01"/>

    <!-- Hurdle: thickness 0.18, width 2.0, height 0.125, at world x = 2.1 -->
    <geom name="flyball_hurdle" type="box"
          pos="2.1 0 0.0625"
          size="0.09 1.0 0.0625"
          material="obstacle"
          friction="1.0 0.005 0.01"/>

    <!--
      Wall lip — vertical step at the wall front (x = 6.4) from z = 0 to
      z = delta_z = 0.10. Modeled as a thin upright box.
      Center: x = 6.4 + 0.025 = 6.425, z = 0.05; size 0.05 × 3.0 × 0.10
    -->
    <geom name="flyball_wall_lip" type="box"
          pos="6.425 0 0.05"
          size="0.025 1.5 0.05"
          material="obstacle"
          friction="1.0 0.005 0.01"/>

    <!--
      Inclined wall ramp — tilted box of full wall thickness 0.35.
      Local axes after euler (0, 0.34906585, 0):
        local +x → world ( cos20°, 0, -sin20°) = ( 0.940, 0, -0.342) inward normal
        local +y → world ( 0, 1, 0 )                                lateral
        local +z → world ( sin20°, 0,  cos20°) = ( 0.342, 0,  0.940) up-the-slope
      Slope length 1.064 m centered on the inclined face midpoint (6.582, 0, 0.600);
      offset inward by half-thickness 0.175 in (sin70°, 0, -cos70°) = (0.940, 0, -0.342)
      → box center (6.747, 0, 0.540).
      half-extents: 0.175 × 1.5 × 0.532  (thickness × width × slope-length)/2
    -->
    <geom name="flyball_wall_ramp" type="box"
          pos="6.747 0 0.540"
          size="0.175 1.5 0.532"
          euler="0 0.34906585 0"
          material="wall_face"
          friction="1.0 0.005 0.01"/>

    <!--
      Wall back / top — vertical box from x ∈ [6.764, 7.114] (length =
      wall_thickness = 0.35), z ∈ [0, 1.10]. The training heightfield has a
      flat top of length 0.30–0.35 m behind the inclined ramp; modeling it
      lets the depth camera see the correct silhouette near the top.
    -->
    <geom name="flyball_wall_back" type="box"
          pos="6.939 0 0.55"
          size="0.175 1.5 0.55"
          material="obstacle"
          friction="1.0 0.005 0.01"/>
  </worldbody>
</mujoco>
